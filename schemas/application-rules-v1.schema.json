{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2d.local/schemas/application-rules-v1.schema.json",
  "title": "A2D application alert rules",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "application", "rules"],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schemaVersion": { "const": "1.0" },
    "application": { "$ref": "#/$defs/application" },
    "defaults": { "$ref": "#/$defs/defaults" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "description": { "type": "string", "maxLength": 4096 },
        "owners": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "labels": {
          "type": "object",
          "maxProperties": 100,
          "propertyNames": { "minLength": 1, "maxLength": 128 },
          "additionalProperties": { "type": "string", "maxLength": 1024 }
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "eventType": { "$ref": "#/$defs/eventType" },
        "alertGroup": { "type": "string", "minLength": 1, "maxLength": 256 },
        "profile": { "$ref": "#/$defs/profile" },
        "schedule": { "$ref": "#/$defs/schedule" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "targets", "signal", "detector", "event"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "groupId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "enabled": { "type": "boolean" },
        "description": { "type": "string", "maxLength": 4096 },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/target" }
        },
        "signal": { "$ref": "#/$defs/signal" },
        "detector": { "$ref": "#/$defs/detector" },
        "event": { "$ref": "#/$defs/event" },
        "profile": { "$ref": "#/$defs/profile" },
        "schedule": { "$ref": "#/$defs/schedule" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectorType", "value"],
      "properties": {
        "selectorType": { "enum": ["ENTITY_ID", "NAME"] },
        "value": { "type": "string", "minLength": 1, "maxLength": 512 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "selectorType": { "const": "ENTITY_ID" } },
            "required": ["selectorType"]
          },
          "then": {
            "properties": { "value": { "pattern": "^SERVICE-.+$" } }
          }
        }
      ]
    },
    "signal": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "metricKey", "aggregation"],
          "properties": {
            "kind": { "const": "METRIC" },
            "metricKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^\\S+$"
            },
            "aggregation": { "enum": ["AVG", "SUM", "MIN", "MAX", "COUNT"] },
            "rollup": { "enum": ["AVG", "MIN", "MAX", "SUM", "TOTAL"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "expression"],
          "properties": {
            "kind": { "const": "DQL" },
            "expression": { "type": "string", "minLength": 1, "maxLength": 65536 }
          }
        }
      ]
    },
    "detector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "condition",
        "violatingSamples",
        "slidingWindow",
        "dealertingSamples",
        "alertOnMissingData"
      ],
      "properties": {
        "model": { "enum": ["STATIC", "AUTO_ADAPTIVE", "SEASONAL"] },
        "condition": { "enum": ["ABOVE", "BELOW", "OUTSIDE"] },
        "threshold": { "type": "number" },
        "numberOfSignalFluctuations": { "type": "number", "minimum": 0, "default": 1 },
        "tolerance": { "type": "number", "minimum": 0, "default": 4 },
        "violatingSamples": { "type": "integer", "minimum": 1, "maximum": 60 },
        "slidingWindow": { "type": "integer", "minimum": 1, "maximum": 60 },
        "dealertingSamples": { "type": "integer", "minimum": 1, "maximum": 60 },
        "alertOnMissingData": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "model": { "const": "STATIC" } },
            "required": ["model"]
          },
          "then": {
            "required": ["threshold"],
            "properties": { "condition": { "enum": ["ABOVE", "BELOW"] } }
          }
        }
      ]
    },
    "eventType": {
      "enum": [
        "AVAILABILITY_EVENT",
        "ERROR_EVENT",
        "PERFORMANCE_EVENT",
        "RESOURCE_CONTENTION_EVENT",
        "CUSTOM_ALERT",
        "CUSTOM_INFO"
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 512 },
        "description": { "type": "string", "maxLength": 8192 },
        "type": { "$ref": "#/$defs/eventType" },
        "alertGroup": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "severity", "delayMinutes"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "severity": {
          "enum": [
            "AVAILABILITY",
            "ERROR",
            "PERFORMANCE",
            "RESOURCE_CONTENTION",
            "CUSTOM_ALERT",
            "INFO"
          ]
        },
        "delayMinutes": { "type": "integer", "minimum": 0, "maximum": 1440 },
        "tagFilters": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["ALWAYS", "ACTIVE_WINDOW", "NOTIFICATION_ONLY"] },
        "timezone": { "type": "string", "minLength": 1, "maxLength": 128 },
        "windows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": { "$ref": "#/$defs/scheduleWindow" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "mode": { "enum": ["ACTIVE_WINDOW", "NOTIFICATION_ONLY"] } },
            "required": ["mode"]
          },
          "then": { "required": ["timezone", "windows"] }
        }
      ]
    },
    "scheduleWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["days", "start", "end"],
      "properties": {
        "days": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": { "enum": ["MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN"] }
        },
        "start": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "end": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        }
      }
    }
  }
}
