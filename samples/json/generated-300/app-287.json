{
    "$schema":  "https://a2d.local/schemas/application-rules-v1.schema.json",
    "schemaVersion":  "1.0",
    "application":  {
                        "id":  "sample-app-287",
                        "name":  "Aplicação de Exemplo 287",
                        "description":  "Aplicação sintética 287 para testes locais de migração",
                        "owners":  [
                                       "sre-team-11"
                                   ],
                        "labels":  {
                                       "businessUnit":  "unit-7",
                                       "environment":  "staging"
                                   }
                    },
    "defaults":  {
                     "enabled":  true,
                     "eventType":  "ERROR_EVENT",
                     "alertGroup":  "sample-app-287",
                     "profile":  {
                                     "name":  "NOC - Equipe 11",
                                     "severity":  "ERROR",
                                     "delayMinutes":  0,
                                     "tagFilters":  [
                                                        "team:team-11"
                                                    ]
                                 },
                     "schedule":  {
                                      "mode":  "ACTIVE_WINDOW",
                                      "timezone":  "America/Sao_Paulo",
                                      "windows":  [
                                                      {
                                                          "days":  [
                                                                       "MON",
                                                                       "TUE",
                                                                       "WED",
                                                                       "THU",
                                                                       "FRI"
                                                                   ],
                                                          "start":  "09:00",
                                                          "end":  "18:00"
                                                      }
                                                  ]
                                  }
                 },
    "rules":  [
                  {
                      "id":  "APPD-SAMPLE-287-ERROR",
                      "name":  "Aplicação 287 - quantidade de erros",
                      "groupId":  "sample-app-287-errors",
                      "description":  "Quantidade de falhas acima do limite operacional",
                      "targets":  [
                                      {
                                          "selectorType":  "NAME",
                                          "value":  "sample-app-287-api"
                                      },
                                      {
                                          "selectorType":  "NAME",
                                          "value":  "sample-app-287-worker"
                                      }
                                  ],
                      "signal":  {
                                     "kind":  "METRIC",
                                     "metricKey":  "dt.service.request.failure_count",
                                     "aggregation":  "SUM"
                                 },
                      "detector":  {
                                       "model":  "STATIC",
                                       "condition":  "ABOVE",
                                       "threshold":  12,
                                       "violatingSamples":  3,
                                       "slidingWindow":  5,
                                       "dealertingSamples":  3,
                                       "alertOnMissingData":  false
                                   },
                      "event":  {
                                    "name":  "Aplicação 287 com erros acima do limite",
                                    "description":  "Erros detectados nos serviços da aplicação 287."
                                }
                  },
                  {
                      "id":  "APPD-SAMPLE-287-LATENCY",
                      "name":  "Aplicação 287 - anomalia de latência",
                      "targets":  [
                                      {
                                          "selectorType":  "ENTITY_ID",
                                          "value":  "SERVICE-000000000000011F"
                                      }
                                  ],
                      "signal":  {
                                     "kind":  "METRIC",
                                     "metricKey":  "dt.service.request.response_time",
                                     "aggregation":  "AVG"
                                 },
                      "detector":  {
                                       "model":  "AUTO_ADAPTIVE",
                                       "condition":  "ABOVE",
                                       "numberOfSignalFluctuations":  1,
                                       "violatingSamples":  3,
                                       "slidingWindow":  5,
                                       "dealertingSamples":  5,
                                       "alertOnMissingData":  false
                                   },
                      "event":  {
                                    "name":  "Latência anormal na aplicação 287",
                                    "type":  "PERFORMANCE_EVENT",
                                    "alertGroup":  "sample-app-287"
                                },
                      "schedule":  {
                                       "mode":  "ALWAYS"
                                   }
                  }
              ]
}