<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <!-- Fluent 2 semantic tokens used by the application. -->
    <SolidColorBrush x:Key="ColorNeutralBackground1" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ColorNeutralBackground2" Color="#F5F5F5" />
    <SolidColorBrush x:Key="ColorNeutralBackground3" Color="#F0F0F0" />
    <SolidColorBrush x:Key="ColorNeutralStroke1" Color="#D1D1D1" />
    <SolidColorBrush x:Key="ColorNeutralStroke2" Color="#E0E0E0" />
    <SolidColorBrush x:Key="ColorNeutralForeground1" Color="#242424" />
    <SolidColorBrush x:Key="ColorNeutralForeground2" Color="#424242" />
    <SolidColorBrush x:Key="ColorNeutralForeground3" Color="#616161" />
    <SolidColorBrush x:Key="ColorNeutralForegroundDisabled" Color="#A6A6A6" />
    <SolidColorBrush x:Key="ColorBrandBackground" Color="#0F6CBD" />
    <SolidColorBrush x:Key="ColorBrandBackgroundHover" Color="#115EA3" />
    <SolidColorBrush x:Key="ColorBrandBackgroundPressed" Color="#0C3B5E" />
    <SolidColorBrush x:Key="ColorBrandBackgroundLight" Color="#EBF3FC" />
    <SolidColorBrush x:Key="ColorStatusSuccess" Color="#107C10" />
    <SolidColorBrush x:Key="ColorStatusSuccessBackground" Color="#DFF6DD" />
    <SolidColorBrush x:Key="ColorStatusWarning" Color="#8A3707" />
    <SolidColorBrush x:Key="ColorStatusWarningBackground" Color="#FFF4CE" />
    <SolidColorBrush x:Key="ColorStatusDanger" Color="#C50F1F" />
    <SolidColorBrush x:Key="ColorStatusDangerBackground" Color="#FDE7E9" />

    <FontFamily x:Key="FontFamilyBase">Segoe UI Variable Text, Segoe UI</FontFamily>

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBase}" />
        <Setter Property="Foreground" Value="{StaticResource ColorNeutralForeground1}" />
        <Setter Property="Background" Value="{StaticResource ColorNeutralBackground2}" />
    </Style>

    <!-- Global control states keep the light surface and foreground coherent,
         independent of the Windows system theme. -->
    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource ColorNeutralBackground1}" />
        <Setter Property="Foreground" Value="{StaticResource ColorNeutralForeground1}" />
        <Setter Property="CaretBrush" Value="{StaticResource ColorNeutralForeground1}" />
        <Setter Property="SelectionBrush" Value="{StaticResource ColorBrandBackground}" />
        <Setter Property="SelectionTextBrush" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorNeutralStroke1}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ColorNeutralForeground3}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ColorBrandBackground}" />
                <Setter Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter Property="Background" Value="{StaticResource ColorNeutralBackground3}" />
                <Setter Property="Foreground" Value="{StaticResource ColorNeutralForeground2}" />
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ColorStatusDanger}" />
                <Setter Property="ToolTip" Value="Valor inválido." />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource ColorNeutralBackground3}" />
                <Setter Property="Foreground" Value="{StaticResource ColorNeutralForegroundDisabled}" />
                <Setter Property="BorderBrush" Value="{StaticResource ColorNeutralStroke2}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource ColorNeutralBackground1}" />
        <Setter Property="Foreground" Value="{StaticResource ColorNeutralForeground1}" />
        <Setter Property="CaretBrush" Value="{StaticResource ColorNeutralForeground1}" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorNeutralStroke1}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ColorNeutralForeground3}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ColorBrandBackground}" />
                <Setter Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource ColorNeutralBackground3}" />
                <Setter Property="Foreground" Value="{StaticResource ColorNeutralForegroundDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource ColorNeutralBackground1}" />
        <Setter Property="Foreground" Value="{StaticResource ColorNeutralForeground1}" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorNeutralStroke1}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ColorNeutralForeground3}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ColorBrandBackground}" />
                <Setter Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource ColorNeutralBackground3}" />
                <Setter Property="Foreground" Value="{StaticResource ColorNeutralForegroundDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="Background" Value="{StaticResource ColorNeutralBackground1}" />
        <Setter Property="Foreground" Value="{StaticResource ColorNeutralForeground1}" />
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{StaticResource ColorBrandBackgroundLight}" />
                <Setter Property="Foreground" Value="{StaticResource ColorBrandBackgroundPressed}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource ColorBrandBackgroundLight}" />
                <Setter Property="Foreground" Value="{StaticResource ColorBrandBackgroundPressed}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Foreground" Value="{StaticResource ColorNeutralForeground1}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource ColorNeutralForegroundDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Button">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Background" Value="{StaticResource ColorNeutralBackground1}" />
        <Setter Property="Foreground" Value="{StaticResource ColorNeutralForeground1}" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorNeutralStroke1}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ColorNeutralBackground3}" />
                <Setter Property="Foreground" Value="{StaticResource ColorNeutralForeground1}" />
                <Setter Property="BorderBrush" Value="{StaticResource ColorNeutralForeground3}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource ColorBrandBackgroundLight}" />
                <Setter Property="Foreground" Value="{StaticResource ColorBrandBackgroundPressed}" />
                <Setter Property="BorderBrush" Value="{StaticResource ColorBrandBackground}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource ColorNeutralBackground3}" />
                <Setter Property="Foreground" Value="{StaticResource ColorNeutralForegroundDisabled}" />
                <Setter Property="BorderBrush" Value="{StaticResource ColorNeutralStroke2}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TitleLarge" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="32" />
        <Setter Property="Foreground" Value="{StaticResource ColorNeutralForeground1}" />
    </Style>

    <Style x:Key="TitleMedium" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="Foreground" Value="{StaticResource ColorNeutralForeground1}" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource ColorNeutralForeground2}" />
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource ColorNeutralForeground3}" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ColorNeutralBackground1}" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorNeutralStroke2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ColorBrandBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorBrandBackground}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource ColorBrandBackgroundHover}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource ColorBrandBackgroundHover}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource ColorBrandBackgroundPressed}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource ColorBrandBackgroundPressed}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="White" />
                            <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavigationButton" TargetType="Button">
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="8,2" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource ColorNeutralForeground2}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="NavigationBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="NavigationBorder" Property="Background" Value="{StaticResource ColorNeutralBackground3}" />
                            <Setter Property="Foreground" Value="{StaticResource ColorNeutralForeground1}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="NavigationBorder" Property="Background" Value="{StaticResource ColorBrandBackgroundLight}" />
                            <Setter Property="Foreground" Value="{StaticResource ColorBrandBackgroundHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="NavigationBorder" Property="BorderBrush" Value="{StaticResource ColorBrandBackground}" />
                            <Setter TargetName="NavigationBorder" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="NavigationBorder" Property="Opacity" Value="0.48" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ActiveNavigationButton" TargetType="Button" BasedOn="{StaticResource NavigationButton}">
        <Setter Property="Background" Value="{StaticResource ColorBrandBackgroundLight}" />
        <Setter Property="Foreground" Value="{StaticResource ColorBrandBackgroundHover}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource ColorNeutralStroke2}" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowHeight" Value="44" />
        <Setter Property="ColumnHeaderHeight" Value="38" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource ColorNeutralForeground1}" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="#FAFAFA" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource ColorNeutralForeground2}" />
        <Setter Property="Background" Value="{StaticResource ColorNeutralBackground3}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorNeutralStroke2}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
