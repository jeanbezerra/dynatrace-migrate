<Window x:Class="A2D.AlertMigrator.Desktop.Views.Alerting.DynatraceAnomalyDetectorDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalhes do detector de anomalia"
        Width="960"
        Height="740"
        MinWidth="780"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        UseLayoutRounding="True">
    <Grid Margin="24,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource CaptionText}" Text="ANOMALY DETECTION · DAVIS" />
                <TextBlock Margin="0,3,0,0" Style="{StaticResource TitleLarge}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                <TextBlock Margin="0,4,0,0" MaxWidth="700" Style="{StaticResource BodyText}" Text="{Binding Description}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="20,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                    <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource ColorStatusSuccess}" /><Style.Triggers><DataTrigger Binding="{Binding IsPresentAndEnabled}" Value="False"><Setter Property="Fill" Value="{StaticResource ColorNeutralForegroundDisabled}" /></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                </Ellipse>
                <TextBlock FontWeight="SemiBold" Text="{Binding StateText}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,0,0,14" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Margin="0,0,18,14"><TextBlock Style="{StaticResource CaptionText}" Text="Modelo" /><TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding Model}" /></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,18,14"><TextBlock Style="{StaticResource CaptionText}" Text="Consulta" /><TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding QueryStatusText}" /></StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,18,14"><TextBlock Style="{StaticResource CaptionText}" Text="Tipo de evento" /><TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding EventType}" TextTrimming="CharacterEllipsis" /></StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,0,14"><TextBlock Style="{StaticResource CaptionText}" Text="Grupo de alerta" /><TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding AlertGroup}" TextTrimming="CharacterEllipsis" /></StackPanel>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,18,0"><TextBlock Style="{StaticResource CaptionText}" Text="Nome do evento" /><TextBlock Margin="0,3,0,0" Text="{Binding EventName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding EventName}" /></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,18,0"><TextBlock Style="{StaticResource CaptionText}" Text="Escopo" /><TextBlock Margin="0,3,0,0" Text="{Binding Scope}" TextTrimming="CharacterEllipsis" /></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="3"><TextBlock Style="{StaticResource CaptionText}" Text="Alterado no tenant" /><TextBlock Margin="0,3,0,0" Text="{Binding RemoteModifiedText}" /></StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="Consulta DQL">
                <Grid Background="{StaticResource ColorNeutralBackground1}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="14,10">
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionText}" Text="A consulta é exibida exatamente como foi armazenada no detector." />
                        <Button HorizontalAlignment="Right" Padding="10,4" Click="CopyDql_Click" AutomationProperties.Name="Copiar consulta DQL">
                            <StackPanel Orientation="Horizontal"><TextBlock Margin="0,0,6,0" FontFamily="Segoe Fluent Icons" Text="&#xE8C8;" /><TextBlock Text="Copiar DQL" /></StackPanel>
                        </Button>
                    </Grid>
                    <TextBox Grid.Row="1" Padding="14,12" Text="{Binding Query, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" VerticalContentAlignment="Top" FontFamily="Cascadia Mono, Consolas" FontSize="13" Background="#1E1E1E" Foreground="#DCDCDC" CaretBrush="White" BorderThickness="0" AutomationProperties.Name="Consulta DQL do detector" />
                </Grid>
            </TabItem>
            <TabItem Header="JSON original">
                <Grid Background="{StaticResource ColorNeutralBackground1}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="14,10">
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionText}" Text="Objeto completo retornado pela Settings API." />
                        <Button HorizontalAlignment="Right" Padding="10,4" Click="CopyJson_Click" AutomationProperties.Name="Copiar JSON do detector">
                            <StackPanel Orientation="Horizontal"><TextBlock Margin="0,0,6,0" FontFamily="Segoe Fluent Icons" Text="&#xE8C8;" /><TextBlock Text="Copiar JSON" /></StackPanel>
                        </Button>
                    </Grid>
                    <TextBox Grid.Row="1" Padding="14,12" Text="{Binding FormattedJson, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" VerticalContentAlignment="Top" FontFamily="Cascadia Mono, Consolas" FontSize="13" Background="#1E1E1E" Foreground="#DCDCDC" CaretBrush="White" BorderThickness="0" AutomationProperties.Name="JSON formatado do detector" />
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="CopyStatus" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
            <Button HorizontalAlignment="Right" MinWidth="92" IsDefault="True" Click="Close_Click" Content="Fechar" />
        </Grid>
    </Grid>
</Window>
