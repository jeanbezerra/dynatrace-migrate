<UserControl x:Class="A2D.AlertMigrator.Desktop.Views.Alerting.DynatraceAnomalyDetectorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="800"
             MinHeight="560">
    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource TitleLarge}" Text="Anomaly Detection" />
                <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionText}" Text="Davis · builtin:davis.anomaly-detectors" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Margin="0,0,8,0"
                        Command="{Binding OpenDetailsCommand}"
                        CommandParameter="{Binding SelectedDetector}"
                        AutomationProperties.Name="Abrir detalhes do detector selecionado">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,7,0" FontFamily="Segoe Fluent Icons" Text="&#xE8A5;" />
                        <TextBlock Text="Ver detalhes" />
                    </StackPanel>
                </Button>
                <Button MinWidth="132" Command="{Binding SyncCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Sincronizar detectores">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,7,0" FontFamily="Segoe Fluent Icons" Text="&#xE895;" />
                        <TextBlock Text="Sincronizar" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,0,0,12" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Margin="0,0,0,5" FontWeight="SemiBold" Text="Tenant" />
                    <ComboBox ItemsSource="{Binding Tenants}" SelectedItem="{Binding SelectedTenant}" DisplayMemberPath="DisplayName" IsEnabled="{Binding IsNotBusy}" AutomationProperties.Name="Tenant Dynatrace" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,18,0">
                    <TextBlock Margin="0,0,0,5" FontWeight="SemiBold" Text="Pesquisar" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pesquisar detectores" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,20,0,0">
                    <CheckBox Margin="0,0,0,5" IsChecked="{Binding OnlyOutsideTimeseries}" Content="Somente fora do padrão" ToolTip="Exibe consultas que não começam com timeseries." />
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Margin="0,0,16,0" IsChecked="{Binding RequestAdminAccess}" IsEnabled="{Binding IsNotBusy}" Content="Visão administrativa" ToolTip="Usa adminAccess=true." />
                        <CheckBox IsChecked="{Binding IncludeMissing}" IsEnabled="{Binding IsNotBusy}" Content="Mostrar ausentes" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,0,0,10" Padding="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                <StackPanel Margin="14,10">
                    <TextBlock Style="{StaticResource CaptionText}" Text="Detectores ativos" />
                    <TextBlock Margin="0,2,0,0" FontSize="20" FontWeight="SemiBold" Text="{Binding ActiveDetectorCountText}" />
                    <TextBlock Style="{StaticResource CaptionText}" Text="{Binding OutsideTimeseriesCountText}" />
                </StackPanel>
                <Border Grid.Column="1" BorderBrush="{StaticResource ColorNeutralStroke2}" BorderThickness="1,0,0,0">
                    <StackPanel Margin="16,10"><TextBlock Style="{StaticResource CaptionText}" Text="Último sincronismo" /><TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Text="{Binding LastSyncText}" /></StackPanel>
                </Border>
                <Border Grid.Column="2" BorderBrush="{StaticResource ColorNeutralStroke2}" BorderThickness="1,0,0,0">
                    <StackPanel Margin="16,10"><TextBlock Style="{StaticResource CaptionText}" Text="Último resultado" /><TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Text="{Binding LastResultText}" /></StackPanel>
                </Border>
                <Border Grid.Column="3" BorderBrush="{StaticResource ColorNeutralStroke2}" BorderThickness="1,0,0,0">
                    <StackPanel Margin="16,10"><TextBlock Style="{StaticResource CaptionText}" Text="Inventário" /><TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Text="{Binding InventoryModeShortText}" /></StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="3" Margin="0,0,0,10" Padding="10,7" CornerRadius="5">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource ColorNeutralBackground3}" />
                    <Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Background" Value="{StaticResource ColorStatusDangerBackground}" /></DataTrigger></Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ProgressBar Width="72" Height="3" Margin="0,0,10,0" VerticalAlignment="Center" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding StatusMessage}" ToolTip="{Binding StatusMessage}" />
                <StackPanel Grid.Column="2" Margin="10,0,0,0" Orientation="Horizontal">
                    <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Style="{StaticResource CaptionText}" Text="{Binding VisibleCountText}" />
                    <Button Padding="9,3" Command="{Binding CancelCommand}" Content="Cancelar" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4" Padding="0" Style="{StaticResource Card}">
            <DataGrid ItemsSource="{Binding DetectorsView}"
                      SelectedItem="{Binding SelectedDetector}"
                      MouseDoubleClick="DetectorsGrid_MouseDoubleClick"
                      IsReadOnly="True"
                      CanUserSortColumns="True"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      AutomationProperties.Name="Detectores de anomalia armazenados">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="2*" Header="Detector" SortMemberPath="Title" Binding="{Binding Title}" />
                    <DataGridTextColumn Width="105" Header="Modelo" SortMemberPath="ModelName" Binding="{Binding ModelName}" />
                    <DataGridTemplateColumn Width="126" Header="Consulta" SortMemberPath="UsesTimeseries">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="18" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE73E;" /><Setter Property="Foreground" Value="{StaticResource ColorStatusSuccess}" />
                                                <Style.Triggers><DataTrigger Binding="{Binding UsesTimeseries}" Value="False"><Setter Property="Text" Value="&#xE7BA;" /><Setter Property="Foreground" Value="{StaticResource ColorStatusWarning}" /></DataTrigger></Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock VerticalAlignment="Center" Text="{Binding QueryStatusText}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Width="1.05*" Header="Tipo de evento" SortMemberPath="EventType" Binding="{Binding EventType}" />
                    <DataGridTextColumn Width="1*" Header="Grupo" SortMemberPath="AlertGroup" Binding="{Binding AlertGroup}" />
                    <DataGridTextColumn Width="138" Header="Alterado" SortMemberPath="Model.RemoteModifiedAt" Binding="{Binding RemoteModifiedText}" />
                    <DataGridTemplateColumn Width="90" Header="Estado" SortMemberPath="StateText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource ColorStatusSuccess}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False"><Setter Property="Fill" Value="{StaticResource ColorNeutralForegroundDisabled}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding IsPresent}" Value="False"><Setter Property="Fill" Value="{StaticResource ColorStatusWarning}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock VerticalAlignment="Center" Text="{Binding StateText}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="66">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button MinWidth="48" Height="28" Padding="8,2"
                                        Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Content="Abrir" AutomationProperties.Name="Abrir detalhes deste detector" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
