<UserControl x:Class="A2D.AlertMigrator.Desktop.Views.Alerting.DynatraceAlertingProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="800"
             MinHeight="560">
    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Primeiro movimento do Z: contexto à esquerda, ações à direita. -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource TitleLarge}" Text="Perfis de alertas" />
                <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionText}" Text="Dynatrace Classic · builtin:alerting.profile" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Margin="0,0,8,0"
                        Padding="12,6"
                        Command="{Binding OpenDetailsCommand}"
                        CommandParameter="{Binding SelectedProfile}"
                        AutomationProperties.Name="Abrir detalhes do perfil selecionado">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,7,0" FontFamily="Segoe Fluent Icons" Text="&#xE8A5;" />
                        <TextBlock Text="Ver detalhes" />
                    </StackPanel>
                </Button>
                <Button MinWidth="132"
                        Command="{Binding SyncCommand}"
                        Style="{StaticResource PrimaryButton}"
                        AutomationProperties.Name="Sincronizar perfis com o tenant">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,7,0" FontFamily="Segoe Fluent Icons" Text="&#xE895;" />
                        <TextBlock Text="Sincronizar" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Segundo movimento do Z: escolha do contexto e filtro. -->
        <Border Grid.Row="1" Margin="0,0,0,12" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Margin="0,0,0,5" FontWeight="SemiBold" Text="Tenant" />
                    <ComboBox ItemsSource="{Binding Tenants}"
                              SelectedItem="{Binding SelectedTenant}"
                              DisplayMemberPath="DisplayName"
                              IsEnabled="{Binding IsNotBusy}"
                              AutomationProperties.Name="Tenant Dynatrace" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,18,0">
                    <TextBlock Margin="0,0,0,5" FontWeight="SemiBold" Text="Pesquisar" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Pesquisar por nome, escopo, zona ou identificador" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,20,0,0" VerticalAlignment="Top">
                    <CheckBox Margin="0,0,0,5"
                              IsChecked="{Binding RequestAdminAccess}"
                              IsEnabled="{Binding IsNotBusy}"
                              Content="Visão administrativa"
                              ToolTip="Usa adminAccess=true. Requer settings:objects:admin." />
                    <CheckBox IsChecked="{Binding IncludeMissing}"
                              IsEnabled="{Binding IsNotBusy}"
                              Content="Mostrar ausentes" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Terceiro movimento do Z: leitura rápida antes da tabela. -->
        <Border Grid.Row="2" Margin="0,0,0,10" Padding="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="14,10">
                    <TextBlock Style="{StaticResource CaptionText}" Text="Perfis ativos" />
                    <TextBlock Margin="0,2,0,0" FontSize="20" FontWeight="SemiBold" Text="{Binding ActiveProfileCountText}" />
                    <TextBlock Style="{StaticResource CaptionText}" Text="{Binding MissingProfileCountText}" />
                </StackPanel>
                <Border Grid.Column="1" BorderBrush="{StaticResource ColorNeutralStroke2}" BorderThickness="1,0,0,0">
                    <StackPanel Margin="16,10">
                        <TextBlock Style="{StaticResource CaptionText}" Text="Último sincronismo" />
                        <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Text="{Binding LastSyncText}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" BorderBrush="{StaticResource ColorNeutralStroke2}" BorderThickness="1,0,0,0">
                    <StackPanel Margin="16,10">
                        <TextBlock Style="{StaticResource CaptionText}" Text="Último resultado" />
                        <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Text="{Binding LastResultText}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" BorderBrush="{StaticResource ColorNeutralStroke2}" BorderThickness="1,0,0,0">
                    <StackPanel Margin="16,10">
                        <TextBlock Style="{StaticResource CaptionText}" Text="Inventário" />
                        <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Text="{Binding InventoryModeShortText}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="3" Margin="0,0,0,10" Padding="10,7" CornerRadius="5">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource ColorNeutralBackground3}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Background" Value="{StaticResource ColorStatusDangerBackground}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar Width="72"
                             Height="3"
                             Margin="0,0,10,0"
                             VerticalAlignment="Center"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding StatusMessage}"
                           ToolTip="{Binding StatusMessage}" />
                <Button Grid.Column="2"
                        Margin="10,0,0,0"
                        Padding="9,3"
                        Command="{Binding CancelCommand}"
                        Content="Cancelar"
                        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Border>

        <!-- Fechamento do Z: dados e ação contextual. -->
        <Border Grid.Row="4" Padding="0" Style="{StaticResource Card}">
            <DataGrid ItemsSource="{Binding ProfilesView}"
                      SelectedItem="{Binding SelectedProfile}"
                      MouseDoubleClick="ProfilesGrid_MouseDoubleClick"
                      IsReadOnly="True"
                      CanUserSortColumns="True"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      AutomationProperties.Name="Perfis de alertas armazenados">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="2*" Header="Perfil" SortMemberPath="Name" Binding="{Binding Name}" />
                    <DataGridTextColumn Width="1.1*" Header="Escopo" SortMemberPath="Scope" Binding="{Binding Scope}" />
                    <DataGridTextColumn Width="1.2*" Header="Zona" SortMemberPath="ManagementZone" Binding="{Binding ManagementZone}" />
                    <DataGridTextColumn Width="72" Header="Regras" SortMemberPath="SeverityRuleCount" Binding="{Binding SeverityRuleCount}" />
                    <DataGridTextColumn Width="72" Header="Filtros" SortMemberPath="EventFilterCount" Binding="{Binding EventFilterCount}" />
                    <DataGridTextColumn Width="138" Header="Alterado" SortMemberPath="Model.RemoteModifiedAt" Binding="{Binding RemoteModifiedText}" />
                    <DataGridTemplateColumn Width="112" Header="Estado" SortMemberPath="IsPresent">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource ColorStatusSuccess}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPresent}" Value="False">
                                                        <Setter Property="Fill" Value="{StaticResource ColorStatusWarning}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock VerticalAlignment="Center" Text="{Binding PresenceText}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="66" Header="">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button MinWidth="48"
                                        Height="28"
                                        Padding="8,2"
                                        Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Content="Abrir"
                                        AutomationProperties.Name="Abrir detalhes deste perfil" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
