<Window x:Class="A2D.AlertMigrator.Desktop.Views.Alerting.DynatraceDavisEventDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalhes do evento de alerta"
        Width="960"
        Height="740"
        MinWidth="780"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        UseLayoutRounding="True">
    <Grid Margin="24,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource CaptionText}" Text="DAVIS EVENT · GRAIL" />
                <TextBlock Margin="0,3,0,0" Style="{StaticResource TitleLarge}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}" Text="{Binding EventId}" TextTrimming="CharacterEllipsis" ToolTip="{Binding EventId}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="20,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                    <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource ColorNeutralForegroundDisabled}" /><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Fill" Value="{StaticResource ColorStatusSuccess}" /></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                </Ellipse>
                <TextBlock FontWeight="SemiBold" Text="{Binding StatusText}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,0,0,14" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Margin="0,0,18,14"><TextBlock Style="{StaticResource CaptionText}" Text="Severidade" /><TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding SeverityText}" /></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,18,14"><TextBlock Style="{StaticResource CaptionText}" Text="Categoria" /><TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding Category}" /></StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,18,14"><TextBlock Style="{StaticResource CaptionText}" Text="Início" /><TextBlock Margin="0,3,0,0" Text="{Binding StartedText}" /></StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,0,14"><TextBlock Style="{StaticResource CaptionText}" Text="Duração" /><TextBlock Margin="0,3,0,0" Text="{Binding DurationText}" /></StackPanel>
                <StackPanel Grid.Row="1" Margin="0,0,18,0"><TextBlock Style="{StaticResource CaptionText}" Text="Tipo de entidade" /><TextBlock Margin="0,3,0,0" Text="{Binding EntityType}" TextTrimming="CharacterEllipsis" /></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,18,0"><TextBlock Style="{StaticResource CaptionText}" Text="Entidade" /><TextBlock Margin="0,3,0,0" Text="{Binding EntityId}" TextTrimming="CharacterEllipsis" ToolTip="{Binding EntityId}" /></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="3"><TextBlock Style="{StaticResource CaptionText}" Text="Origem" /><TextBlock Margin="0,3,0,0" Text="{Binding Provider}" TextTrimming="CharacterEllipsis" /></StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="Contexto">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource ColorNeutralBackground1}">
                    <StackPanel Margin="16,14">
                        <TextBlock FontWeight="SemiBold" Text="Descrição" />
                        <TextBlock Margin="0,6,0,18" Text="{Binding Description}" TextWrapping="Wrap" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Margin="0,0,24,14"><TextBlock Style="{StaticResource CaptionText}" Text="Grupo de alerta" /><TextBlock Margin="0,3,0,0" Text="{Binding AlertGroup}" TextWrapping="Wrap" /></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,0,14"><TextBlock Style="{StaticResource CaptionText}" Text="Tipo de evento" /><TextBlock Margin="0,3,0,0" Text="{Binding EventType}" TextWrapping="Wrap" /></StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,0,24,14"><TextBlock Style="{StaticResource CaptionText}" Text="Detector · object ID" /><TextBlock Margin="0,3,0,0" Text="{Binding SettingsObjectId}" TextWrapping="Wrap" /></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,14"><TextBlock Style="{StaticResource CaptionText}" Text="Schema" /><TextBlock Margin="0,3,0,0" Text="{Binding SettingsSchemaId}" TextWrapping="Wrap" /></StackPanel>
                            <StackPanel Grid.Row="2" Margin="0,0,24,14"><TextBlock Style="{StaticResource CaptionText}" Text="Transição" /><TextBlock Margin="0,3,0,0" Text="{Binding StatusTransition}" /></StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,14"><TextBlock Style="{StaticResource CaptionText}" Text="Encerramento" /><TextBlock Margin="0,3,0,0" Text="{Binding EndedText}" /></StackPanel>
                            <StackPanel Grid.Row="3" Orientation="Horizontal">
                                <TextBlock Style="{StaticResource CaptionText}" Text="Manutenção: " /><TextBlock Text="{Binding MaintenanceText}" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Style="{StaticResource CaptionText}" Text="Frequente: " /><TextBlock Margin="0,0,20,0" Text="{Binding FrequentText}" />
                                <TextBlock Style="{StaticResource CaptionText}" Text="Mesclagem: " /><TextBlock Text="{Binding MergingText}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Consulta DQL">
                <Grid Background="{StaticResource ColorNeutralBackground1}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="14,10">
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionText}" Text="Consulta associada ao evento, quando fornecida pelo Dynatrace." />
                        <Button HorizontalAlignment="Right" Padding="10,4" Click="CopyDql_Click" AutomationProperties.Name="Copiar consulta DQL do evento">
                            <StackPanel Orientation="Horizontal"><TextBlock Margin="0,0,6,0" FontFamily="Segoe Fluent Icons" Text="&#xE8C8;" /><TextBlock Text="Copiar DQL" /></StackPanel>
                        </Button>
                    </Grid>
                    <TextBox Grid.Row="1" Padding="14,12" Text="{Binding Query, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" VerticalContentAlignment="Top" FontFamily="Cascadia Mono, Consolas" FontSize="13" Background="#1E1E1E" Foreground="#DCDCDC" CaretBrush="White" BorderThickness="0" AutomationProperties.Name="Consulta DQL do evento" />
                </Grid>
            </TabItem>
            <TabItem Header="JSON original">
                <Grid Background="{StaticResource ColorNeutralBackground1}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="14,10">
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionText}" Text="Registro retornado por dt.davis.events." />
                        <Button HorizontalAlignment="Right" Padding="10,4" Click="CopyJson_Click" AutomationProperties.Name="Copiar JSON do evento">
                            <StackPanel Orientation="Horizontal"><TextBlock Margin="0,0,6,0" FontFamily="Segoe Fluent Icons" Text="&#xE8C8;" /><TextBlock Text="Copiar JSON" /></StackPanel>
                        </Button>
                    </Grid>
                    <TextBox Grid.Row="1" Padding="14,12" Text="{Binding FormattedJson, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" VerticalContentAlignment="Top" FontFamily="Cascadia Mono, Consolas" FontSize="13" Background="#1E1E1E" Foreground="#DCDCDC" CaretBrush="White" BorderThickness="0" AutomationProperties.Name="JSON formatado do evento" />
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="CopyStatus" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
            <Button HorizontalAlignment="Right" MinWidth="92" IsDefault="True" Click="Close_Click" Content="Fechar" />
        </Grid>
    </Grid>
</Window>
