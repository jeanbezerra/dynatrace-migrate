<UserControl x:Class="A2D.AlertMigrator.Desktop.Views.Help.AppDynamicsHelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource ColorNeutralBackground2}">
    <UserControl.Resources>
        <Style x:Key="PermissionCode" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource ColorBrandBackgroundPressed}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="StepNumber" TargetType="Border">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Background" Value="{StaticResource ColorBrandBackgroundLight}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,1,12,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32">
            <StackPanel Margin="0,0,0,16">
                <TextBlock Style="{StaticResource TitleLarge}" Text="Token e permissões do AppDynamics" />
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource BodyText}"
                           Text="Como liberar um API Client OAuth para ler aplicações, health rules, políticas e demais configurações de alertas." />
            </StackPanel>

            <Border Style="{StaticResource Card}" Background="{StaticResource ColorBrandBackgroundLight}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="17" Foreground="{StaticResource ColorBrandBackgroundHover}" Text="&#xE946;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock FontWeight="SemiBold" Text="Use um API Client OAuth" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource BodyText}" TextWrapping="Wrap">
                            <Run Text="Não use a senha de uma conta pessoal. O administrador deve criar um " /><Run FontWeight="SemiBold" Text="API Client" /><Run Text=", associar uma função de leitura e gerar um token temporário. O Client Secret funciona como senha para obter tokens e não deve ser informado como Bearer token." />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleMedium}" Text="Permissões recomendadas" />
                    <TextBlock Margin="0,4,0,14" Style="{StaticResource CaptionText}" Text="Na migração AppDynamics → Dynatrace, a origem deve permanecer somente leitura." />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="290" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.ColumnSpan="3" Background="{StaticResource ColorNeutralBackground3}" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="290" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="Uso" />
                                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Permissão no Controller" />
                                <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Orientação" />
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="1" Margin="10,11" TextWrapping="Wrap" Text="Inventário e alertas" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="10,11" Style="{StaticResource PermissionCode}" Text="Applications > View" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Margin="10,11" Style="{StaticResource BodyText}" TextWrapping="Wrap" Text="Conceda View somente em cada aplicação que será migrada. Esse acesso cobre a leitura de health rules, violações e políticas de alerta no domínio APM." />
                        <Border Grid.Row="1" Grid.ColumnSpan="3" VerticalAlignment="Bottom" BorderBrush="{StaticResource ColorNeutralStroke2}" BorderThickness="0,0,0,1" />

                        <TextBlock Grid.Row="2" Margin="10,11" TextWrapping="Wrap" Text="Alterar health rules" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="10,11" Style="{StaticResource PermissionCode}" Text="Configure Health Rules" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Margin="10,11" Style="{StaticResource BodyText}" TextWrapping="Wrap" Text="Não é necessária para exportar. Libere somente se uma futura função alterar a origem." />
                        <Border Grid.Row="2" Grid.ColumnSpan="3" VerticalAlignment="Bottom" BorderBrush="{StaticResource ColorNeutralStroke2}" BorderThickness="0,0,0,1" />

                        <TextBlock Grid.Row="3" Margin="10,11" TextWrapping="Wrap" Text="Alterar políticas ou ações" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="10,11" Style="{StaticResource PermissionCode}" Text="Configure Policies&#x0a;Configure Actions" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Margin="10,11" Style="{StaticResource BodyText}" TextWrapping="Wrap" Text="Não são necessárias para leitura. Não associe essas permissões ao cliente desta migração." />
                        <Border Grid.Row="3" Grid.ColumnSpan="3" VerticalAlignment="Bottom" BorderBrush="{StaticResource ColorNeutralStroke2}" BorderThickness="0,0,0,1" />

                        <TextBlock Grid.Row="4" Margin="10,11" TextWrapping="Wrap" Text="Templates da conta" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Margin="10,11" Style="{StaticResource PermissionCode}" Text="Configure Alerting Templates" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Margin="10,11" Style="{StaticResource BodyText}" TextWrapping="Wrap" Text="Permissão administrativa. Solicite apenas se o escopo incluir templates globais e a API realmente exigir alteração." />
                    </Grid>

                    <Border Margin="0,14,0,0" Padding="12" CornerRadius="6" Background="{StaticResource ColorStatusWarningBackground}">
                        <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Text="Atenção a funções herdadas: " /><Run Text="uma função ampla associada ao mesmo API Client prevalece sobre uma função restrita. Revise todas as funções anexadas e evite Account Owner, Administrator e acesso View global." />
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleMedium}" Text="Processo de criação e liberação" />
                    <TextBlock Margin="0,4,0,16" Style="{StaticResource CaptionText}" Text="A criação exige Account Owner ou uma função com Administer users, groups, roles." />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource StepNumber}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Text="1" /></Border>
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyText}" TextWrapping="Wrap" Text="Em Settings > Administration > Roles, crie uma função exclusiva, como A2D Migration Read. Habilite Applications > View somente para as aplicações do escopo." />
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource StepNumber}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Text="2" /></Border>
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyText}" TextWrapping="Wrap" Text="Em Settings > Administration > API Clients, selecione Create. Informe nome e descrição, gere o Client Secret e defina uma validade curta para os tokens gerados pela API." />
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource StepNumber}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Text="3" /></Border>
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyText}" TextWrapping="Wrap" Text="Associe somente a função de leitura revisada. Guarde o Client Secret em um cofre aprovado. Ele não deve ser gravado em arquivos de entrada, no SQLite nem nos logs." />
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource StepNumber}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Text="4" /></Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Text="Gere um Temporary Access Token pela interface ou obtenha um token OAuth por POST no endpoint abaixo. O client_id usa o formato nomeDoCliente@nomeDaConta." />
                            <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="4" Background="{StaticResource ColorNeutralBackground3}">
                                <TextBlock Style="{StaticResource PermissionCode}" Text="https://&lt;controller&gt;/controller/api/oauth/access_token" />
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource StepNumber}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Text="5" /></Border>
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyText}" TextWrapping="Wrap" Text="Em Configurações, abra o teste do AppDynamics, informe a URL HTTPS e use o access token como Bearer. Valide ao menos uma aplicação permitida e outra fora do escopo. Um 401 indica autenticação; um 403 indica RBAC insuficiente." />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleMedium}" Text="Modelo curto para o chamado de acesso" />
                    <TextBox Margin="0,12,0,0"
                             MinHeight="138"
                             Padding="12"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             Text="Solicito um API Client OAuth somente leitura para a migração AppDynamics → Dynatrace.&#x0a;Controller e conta: [informar]&#x0a;Responsável e validade: [informar]&#x0a;Origem da conexão: [máquina, rede e proxy]&#x0a;Aplicações autorizadas: [listar]&#x0a;Função solicitada: Applications > View apenas nas aplicações listadas.&#x0a;Aprovador e janela de uso: [informar]" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleMedium}" Text="Documentação oficial" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button Margin="0,0,8,8" Command="{Binding OpenApiClientsCommand}" Content="API Clients e OAuth" />
                        <Button Margin="0,0,8,8" Command="{Binding OpenLeastPrivilegeCommand}" Content="Menor privilégio" />
                        <Button Margin="0,0,8,8" Command="{Binding OpenHealthRuleApiCommand}" Content="Health Rule API" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Text="Os links são abertos no navegador padrão. Nomes de menus podem variar entre versões SaaS e Controller on-premises." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
